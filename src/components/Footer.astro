---
import { Image } from 'astro:assets';
import lockup from '../assets/brand/logo-house-lockup.png';
import { site, allPages, socials } from '../data/site';
---

<footer class="site-footer">
  <div class="panel">
    <div class="grid">
      <Image
        class="logo"
        src={lockup}
        alt="Indigo Interiors - Dressed to let, Dressed to sell"
        widths={[160, 320]}
        sizes="160px"
      />

      <nav class="col col--pages" aria-labelledby="footer-pages">
        <h2 class="col__label" id="footer-pages">Pages</h2>
        <ul role="list">
          {allPages.map((p) => <li><a href={p.href}>{p.label}</a></li>)}
        </ul>
      </nav>

      <div class="col col--contact">
        <h2 class="col__label">Contact</h2>
        <a href={site.phone.href}>Tel: {site.phone.display}</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>

      <div class="top">
        <a class="top__btn" href="#top" aria-label="Back to top">↑</a>
      </div>
    </div>

    <div class="bottom">
      <ul role="list" class="socials">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener">
                {s.label}
                <span class="visually-hidden"> (opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="credit">
        Designed and developed by <a href={site.credit.href} target="_blank" rel="noopener">{site.credit.name}</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: var(--section-gap) var(--page-pad) clamp(16px, 2vw, 24px);
  }

  .panel {
    max-width: var(--container-max);
    margin: 0 auto;
    background: var(--color-teal);
    color: var(--color-white);
    border-radius: var(--radius-panel);
    padding: clamp(32px, 5vw, 64px) clamp(24px, 5vw, 64px) 28px;
  }

  .site-footer a {
    color: var(--color-white);
  }

  /* Phones: logo with the back-to-top button beside it, then pages, then contact */
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'logo top'
      'pages pages'
      'contact contact';
    gap: 32px 24px;
    align-items: start;
  }

  .logo {
    grid-area: logo;
    width: clamp(120px, 16vw, 160px);
    height: auto;
  }

  .col--pages {
    grid-area: pages;
  }

  .col--contact {
    grid-area: contact;
  }

  .top {
    grid-area: top;
    display: flex;
    justify-content: flex-end;
  }

  /* Tablets: three columns, back-to-top tucked under the contact details */
  @media (min-width: 600px) {
    .grid {
      grid-template-columns: auto minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        'logo pages contact'
        'logo pages top';
      gap: 24px clamp(24px, 4vw, 40px);
    }

    .top {
      justify-content: flex-start;
      align-self: end;
    }
  }

  /* Desktop: the design's four columns */
  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr)) auto;
      grid-template-areas: 'logo pages contact top';
      gap: 40px;
    }

    .top {
      align-self: start;
      justify-content: flex-end;
    }
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 17px;
  }

  .col ul {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .col a {
    display: inline-flex;
    align-items: center;
    min-height: 26px;
    overflow-wrap: anywhere;
    transition: opacity var(--dur-fast);
  }

  .col a:hover {
    opacity: 0.7;
  }

  .col__label {
    font-size: 14px;
    font-weight: var(--weight-semibold);
    opacity: 0.7;
    margin-bottom: 6px;
  }

  .top__btn {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.5);
    font-size: 20px;
    transition: background-color var(--dur-base);
  }

  .top__btn:hover {
    background: rgb(255 255 255 / 0.14);
  }

  .bottom {
    margin-top: clamp(40px, 5vw, 64px);
    padding-top: 22px;
    border-top: 1px solid var(--line-on-teal);
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 14px;
  }

  .socials {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    font-weight: var(--weight-semibold);
  }

  .socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 26px;
    min-width: 24px;
    transition: opacity var(--dur-fast);
  }

  /* Touch screens: every footer link becomes a comfortable 44px target */
  @media (pointer: coarse) {
    .col ul,
    .col {
      gap: 0;
    }

    .col__label {
      margin-bottom: 4px;
    }

    .col a {
      min-height: 44px;
    }

    .socials {
      gap: 0 6px;
      margin-inline: -8px; /* cancels the links' side padding so every wrapped row lines up with the text above */
    }

    .socials a {
      min-height: 44px;
      min-width: 44px;
      padding-inline: 8px;
    }
  }

  .socials a:hover {
    opacity: 0.7;
  }

  .credit {
    opacity: 0.8;
  }

  .credit a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
