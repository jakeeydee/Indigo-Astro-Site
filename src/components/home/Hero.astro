---
import { Image } from 'astro:assets';
import heroImage from '../../assets/images/hero-living-room.jpg';
import { routes } from '../../data/site';
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="frame">
    <Image
      class="photo"
      src={heroImage}
      alt="Living room with curved sofa and round rug"
      widths={[640, 960, 1280, 1600, 2000, 2400]}
      sizes="112vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="scrim" aria-hidden="true"></div>

    <div class="content">
      <div class="inner">
        <div>
          <p class="eyebrow-line"><span class="rule" aria-hidden="true"></span>Furniture · Curtains · Blinds</p>
          <h1 class="title" id="hero-title">Indigo<br /><span>Interiors</span></h1>
        </div>
        <div class="aside">
          <p class="lede">
            Interior Design for the residential and commercial sector, if you are redesigning or refurbishing your homes
            or offices.
          </p>
          <div class="actions">
            <a class="btn btn--white" href="#services">Our Services</a>
            <a class="btn btn--ghost-light" href={routes.about}>About Us</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!--
    Cream corner pieces that fade in as the photo shrinks, giving it rounded corners without repainting it.
    They sit in their own layer that moves exactly like the frame but isn't clipped by it, so they can
    overlap the frame's edge and hide the hairline that clipping would leave.
  -->
  <div class="corners" aria-hidden="true">
    <span class="corner corner--tl"></span>
    <span class="corner corner--tr"></span>
    <span class="corner corner--bl"></span>
    <span class="corner corner--br"></span>
  </div>
</section>

<script>
  /*
    Scroll-linked hero. Over the first 80% of a screen of scrolling, the photo shrinks into a
    rounded card and the image settles from a slight zoom.

    Browsers with CSS scroll-driven animations (Safari 26+, Chrome, Edge) run it entirely in CSS,
    in step with the scroll itself. This script is only the fallback for the rest (e.g. Firefox):
    it writes the eased progress to --e (0 to 1) once per frame.
  */
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const cssDriven = CSS.supports('animation-timeline: scroll()');

  if (hero && !cssDriven) {
    let frame = 0;

    const update = () => {
      frame = 0;
      const p = Math.min(1, Math.max(0, window.scrollY / (window.innerHeight * 0.8)));
      const eased = 1 - (1 - p) ** 2;
      hero.style.setProperty('--e', eased.toFixed(4));
    };

    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    const setMotion = () => {
      if (reduce.matches) {
        hero.removeAttribute('data-motion');
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
      } else {
        hero.setAttribute('data-motion', '');
        update();
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
      }
    };

    setMotion();
    reduce.addEventListener('change', setMotion);
  }
</script>

<style>
  /*
    Fill the largest viewport (the screen with the browser's bars collapsed), so on phones the photo
    reaches the bottom edge behind Safari's translucent toolbar instead of leaving a cream strip.
  */
  .hero {
    position: relative;
    height: 100vh;
    height: 100lvh;
    min-height: 600px;
  }

  .frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /*
    Rounded corners: quarter-circle cream masks in each corner. They're 46px so that once the frame
    has shrunk to 86% they read as the design's 40px radius. Only their opacity animates.
  */
  .corners {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /*
    Each piece is solid cream outside a quarter circle and grows from 0 to full size, scaled from
    the frame's true corner, so the radius itself grows (0 to 40px once the frame is at 86%).
    The pieces overhang the frame's edge by 2px so no hairline of photo shows past the curve.
  */
  .corner {
    position: absolute;
    width: 48px;
    height: 48px;
    transform: scale(0);
    --mask: transparent 45.5px, var(--color-cream) 46px;
  }

  .corner--tl {
    top: -2px;
    left: -2px;
    transform-origin: 2px 2px;
    background: radial-gradient(circle at 100% 100%, var(--mask));
  }

  .corner--tr {
    top: -2px;
    right: -2px;
    transform-origin: calc(100% - 2px) 2px;
    background: radial-gradient(circle at 0 100%, var(--mask));
  }

  .corner--bl {
    bottom: -2px;
    left: -2px;
    transform-origin: 2px calc(100% - 2px);
    background: radial-gradient(circle at 100% 0, var(--mask));
  }

  .corner--br {
    bottom: -2px;
    right: -2px;
    transform-origin: calc(100% - 2px) calc(100% - 2px);
    background: radial-gradient(circle at 0 0, var(--mask));
  }

  /*
    Motion. Only transform and opacity animate, so the browser can run it on the compositor.
    Eased like the design: ease-out quad over the first 80% of a screen of scrolling.
  */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .frame,
      .corners,
      .photo,
      .corner {
        animation-duration: 1ms; /* required by some engines; the scroll timeline sets the real progress */
        animation-timing-function: cubic-bezier(0.25, 0.46, 0.45, 0.94);
        animation-fill-mode: both;
        animation-timeline: scroll(root block);
        animation-range: 0 80vh;
      }

      .frame,
      .corners {
        transform-origin: 50% 0;
        animation-name: hero-shrink;
        will-change: transform;
      }

      .photo {
        animation-name: hero-settle;
        will-change: transform;
      }

      .corner {
        animation-name: hero-corners;
      }
    }
  }

  @keyframes hero-shrink {
    from {
      transform: none;
    }
    to {
      transform: translateY(24px) scale(0.86);
    }
  }

  @keyframes hero-settle {
    from {
      transform: scale(1.12);
    }
    to {
      transform: none;
    }
  }

  @keyframes hero-corners {
    from {
      transform: scale(0);
    }
    to {
      transform: scale(1);
    }
  }

  /* Fallback for browsers without scroll-driven animations: --e comes from the script above */
  .hero[data-motion] .frame,
  .hero[data-motion] .corners {
    transform-origin: 50% 0;
    transform: translateY(calc(var(--e, 0) * 24px)) scale(calc(1 - var(--e, 0) * 0.14));
    will-change: transform;
  }

  .hero[data-motion] .photo {
    transform: scale(calc(1.12 - var(--e, 0) * 0.12));
    will-change: transform;
  }

  .hero[data-motion] .corner {
    transform: scale(var(--e, 0));
  }

  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(10 22 20 / 0.35) 0%,
      rgb(10 22 20 / 0) 30%,
      rgb(10 22 20 / 0.15) 55%,
      rgb(10 22 20 / 0.72) 100%
    );
  }

  .content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0 clamp(20px, 5vw, 72px) clamp(32px, 6vh, 72px);
    color: var(--color-white);
  }

  /*
    The hero is as tall as the largest viewport, so keep the heading and buttons clear of the
    browser's toolbar: lift them by the difference between the large and small viewports
    (zero on desktop, roughly the toolbar's height on phones).
  */
  @supports (height: 100svh) {
    .content {
      padding-bottom: calc(clamp(32px, 6svh, 72px) + (100lvh - 100svh));
    }
  }

  .inner {
    max-width: var(--container-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(20px, 4vw, 56px);
    align-items: end;
  }

  .eyebrow-line {
    font-size: clamp(14px, 1.2vw, 17px);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.04em;
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .rule {
    width: 28px;
    height: 1px;
    background: var(--color-white);
  }

  .title {
    font-size: clamp(56px, 10vw, 148px);
    line-height: 0.9;
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-display);
  }

  .title span {
    font-weight: var(--weight-medium);
  }

  .aside {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 440px;
    justify-self: start;
  }

  /* Beside the title (wide screens) it sits on the right; stacked below it, it lines up on the left */
  @media (min-width: 1000px) {
    .inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .aside {
      justify-self: end;
    }
  }

  .lede {
    font-size: clamp(18px, 1.5vw, 21px);
    line-height: 1.45;
  }

  .actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
</style>
