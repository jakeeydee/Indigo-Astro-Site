---
import { Image } from 'astro:assets';
import heroImage from '../../assets/images/hero-living-room.jpg';
import { routes } from '../../data/site';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="frame">
    <Image
      class="photo"
      src={heroImage}
      alt="Living room with curved sofa and round rug"
      widths={[640, 960, 1280, 1600, 2000, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="scrim" aria-hidden="true"></div>

    <div class="content">
      <div class="inner">
        <div>
          <p class="eyebrow-line"><span class="rule" aria-hidden="true"></span>Furniture · Curtains · Blinds</p>
          <h1 class="title" id="hero-title">Indigo<br /><span>Interiors</span></h1>
        </div>
        <div class="aside">
          <p class="lede">
            Interior Design for the residential and commercial sector, if you are redesigning or refurbishing your homes
            or offices.
          </p>
          <div class="actions">
            <a class="btn btn--white" href="#services">Our Services</a>
            <a class="btn btn--ghost-light" href={routes.about}>About Us</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 600px;
  }

  .frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(10 22 20 / 0.35) 0%,
      rgb(10 22 20 / 0) 30%,
      rgb(10 22 20 / 0.15) 55%,
      rgb(10 22 20 / 0.72) 100%
    );
  }

  .content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0 clamp(20px, 5vw, 72px) clamp(32px, 6vh, 72px);
    color: var(--color-white);
  }

  .inner {
    max-width: var(--container-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: clamp(20px, 4vw, 56px);
    align-items: end;
  }

  .eyebrow-line {
    font-size: clamp(14px, 1.2vw, 17px);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.04em;
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .rule {
    width: 28px;
    height: 1px;
    background: var(--color-white);
  }

  .title {
    font-size: clamp(56px, 10vw, 148px);
    line-height: 0.9;
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-display);
  }

  .title span {
    font-weight: var(--weight-medium);
  }

  .aside {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 440px;
    justify-self: end;
  }

  .lede {
    font-size: clamp(18px, 1.5vw, 21px);
    line-height: 1.45;
  }

  .actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
</style>
