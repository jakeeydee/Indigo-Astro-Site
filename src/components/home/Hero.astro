---
import { Image } from 'astro:assets';
import heroImage from '../../assets/images/hero-living-room.jpg';
import { routes } from '../../data/site';
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="frame">
    <Image
      class="photo"
      src={heroImage}
      alt="Living room with curved sofa and round rug"
      widths={[640, 960, 1280, 1600, 2000, 2400]}
      sizes="112vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="scrim" aria-hidden="true"></div>

    <div class="content">
      <div class="inner">
        <div>
          <p class="eyebrow-line"><span class="rule" aria-hidden="true"></span>Furniture · Curtains · Blinds</p>
          <h1 class="title" id="hero-title">Indigo<br /><span>Interiors</span></h1>
        </div>
        <div class="aside">
          <p class="lede">
            Interior Design for the residential and commercial sector, if you are redesigning or refurbishing your homes
            or offices.
          </p>
          <div class="actions">
            <a class="btn btn--white" href="#services">Our Services</a>
            <a class="btn btn--ghost-light" href={routes.about}>About Us</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Scroll-linked hero: over the first 80% of a viewport of scrolling, the photo frame shrinks
  // into a rounded card and the image settles from a slight zoom. Progress is eased (ease-out quad)
  // and written to --e (0 to 1), which the CSS turns into transforms.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (hero) {
    let frame = 0;

    const update = () => {
      frame = 0;
      const p = Math.min(1, Math.max(0, window.scrollY / (window.innerHeight * 0.8)));
      const eased = 1 - (1 - p) ** 2;
      hero.style.setProperty('--e', eased.toFixed(4));
    };

    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    const setMotion = () => {
      if (reduce.matches) {
        hero.removeAttribute('data-motion');
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
      } else {
        hero.setAttribute('data-motion', '');
        update();
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
      }
    };

    setMotion();
    reduce.addEventListener('change', setMotion);
  }
</script>

<style>
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 600px;
  }

  .frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Driven by --e from the script above; only active when motion is allowed */
  .hero[data-motion] .frame {
    transform-origin: 50% 0;
    transform: translateY(calc(var(--e, 0) * 24px)) scale(calc(1 - var(--e, 0) * 0.14));
    border-radius: calc(var(--e, 0) * 40px);
    will-change: transform;
  }

  .hero[data-motion] .photo {
    transform: scale(calc(1.12 - var(--e, 0) * 0.12));
    will-change: transform;
  }

  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(10 22 20 / 0.35) 0%,
      rgb(10 22 20 / 0) 30%,
      rgb(10 22 20 / 0.15) 55%,
      rgb(10 22 20 / 0.72) 100%
    );
  }

  .content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0 clamp(20px, 5vw, 72px) clamp(32px, 6vh, 72px);
    color: var(--color-white);
  }

  .inner {
    max-width: var(--container-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(20px, 4vw, 56px);
    align-items: end;
  }

  .eyebrow-line {
    font-size: clamp(14px, 1.2vw, 17px);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.04em;
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .rule {
    width: 28px;
    height: 1px;
    background: var(--color-white);
  }

  .title {
    font-size: clamp(56px, 10vw, 148px);
    line-height: 0.9;
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-display);
  }

  .title span {
    font-weight: var(--weight-medium);
  }

  .aside {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 440px;
    justify-self: start;
  }

  /* Beside the title (wide screens) it sits on the right; stacked below it, it lines up on the left */
  @media (min-width: 1000px) {
    .inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .aside {
      justify-self: end;
    }
  }

  .lede {
    font-size: clamp(18px, 1.5vw, 21px);
    line-height: 1.45;
  }

  .actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
</style>
