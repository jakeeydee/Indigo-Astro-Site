---
import { Image } from 'astro:assets';
import { services, serviceHref } from '../../data/site';
---

<section class="section" id="services" aria-labelledby="services-heading">
  <div class="container">
    <div class="head">
      <h2 id="services-heading">Our Services</h2>
      <p class="count" aria-hidden="true">01 – 03</p>
    </div>

    <ul role="list" class="grid">
      {
        services.map((s) => (
          <li>
            <a class="card" href={serviceHref(s.slug)}>
              <span class="media">
                <Image src={s.image} alt={s.imageAlt} widths={[480, 720, 960]} sizes="(min-width: 1320px) 420px, (min-width: 1000px) 33vw, (min-width: 600px) 42vw, 100vw" />
              </span>
              <span class="body">
                <span class="num">{s.num}</span>
                <span class="title">{s.cardTitle}</span>
                <span class="tag">{s.tagline}</span>
                <span class="more">
                  To Gallery <span class="arrow-badge" aria-hidden="true">→</span>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  h2 {
    font-size: clamp(40px, 5.5vw, 76px);
    letter-spacing: var(--tracking-heading);
    line-height: 1;
  }

  .count {
    font-size: 15px;
    color: var(--color-muted);
    font-weight: var(--weight-medium);
  }

  /* Phones: stacked cards. Tablets: one card per row, photo beside text. Desktop: three across. */
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(16px, 2vw, 24px);
  }

  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .card {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 20px;
    background: var(--color-white);
    border-radius: var(--radius-card);
    padding: 10px 10px 26px;
    color: var(--color-ink);
    transition:
      transform var(--dur-slow) var(--ease-media),
      box-shadow var(--dur-slow);
  }

  .card:hover {
    color: var(--color-ink);
    transform: translateY(-6px);
    box-shadow: var(--shadow-card-hover);
  }

  .card:focus-visible {
    box-shadow: var(--shadow-card-hover);
  }

  .media {
    display: block;
    border-radius: var(--radius-media);
    overflow: hidden;
    aspect-ratio: 4 / 3.4;
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-zoom) var(--ease-media);
  }

  .card:hover .media img {
    transform: scale(1.06);
  }

  .body {
    padding: 0 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .num {
    font-size: 14px;
    font-weight: var(--weight-semibold);
    color: var(--color-teal);
  }

  .title {
    font-size: 26px;
    font-weight: var(--weight-medium);
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .tag {
    font-size: 17px;
    color: var(--color-muted);
    line-height: 1.45;
    flex: 1;
  }

  .more {
    margin-top: 8px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: var(--weight-semibold);
    font-size: 15px;
  }

  @media (min-width: 600px) and (max-width: 999px) {
    .card {
      flex-direction: row;
      align-items: stretch;
      gap: 24px;
      padding: 10px;
    }

    .media {
      flex: 0 0 46%;
      aspect-ratio: 4 / 3;
    }

    .body {
      padding: 14px 12px 12px 0;
      justify-content: center;
    }

    .tag {
      flex: 0 0 auto;
    }
  }
</style>
