---
import { Image } from 'astro:assets';
import { routes, services, serviceHref, site } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href;
const inServices = path.startsWith('/services/');

const mobilePrimary = [
  { label: 'Home', href: routes.home },
  { label: 'About Us', href: routes.about },
  { label: 'Contact Us', href: routes.contact },
];
---

<header class="site-header" data-header>
  <div class="menu-backdrop" aria-hidden="true" data-menu-backdrop></div>

  <div class="bar">
    <nav class="nav" aria-label="Primary">
      <a class="nav__item" href={routes.home} aria-current={isCurrent(routes.home) ? 'page' : undefined}>Home</a>
      <a class="nav__item" href={routes.about} aria-current={isCurrent(routes.about) ? 'page' : undefined}>About Us</a>

      <div class="dd" data-dropdown>
        <button
          class:list={['nav__item', 'dd__trigger', { 'is-active': inServices }]}
          type="button"
          aria-expanded="false"
          aria-controls="services-menu"
          data-dropdown-trigger
        >
          Services <span class="dd__chevron" aria-hidden="true"></span>
        </button>

        <div class="dd__panel" id="services-menu" data-dropdown-panel>
          <div class="dd__card">
            <ul role="list" class="dd__grid">
              {
                services.map((s, i) => (
                  <li>
                    <a
                      class="dd__item"
                      style={`--i: ${i}`}
                      href={serviceHref(s.slug)}
                      aria-current={isCurrent(serviceHref(s.slug)) ? 'page' : undefined}
                    >
                      <span class="dd__media">
                        <Image
                          src={s.image}
                          alt=""
                          widths={[240, 480]}
                          sizes="240px"
                          loading="eager"
                          fetchpriority="low"
                        />
                      </span>
                      <span class="dd__text">
                        <span class="dd__num">{s.num}</span>
                        <span class="dd__title">{s.cardTitle}</span>
                        <span class="dd__tag">{s.tagline}</span>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
            <a class="dd__cta" href={routes.contact}>
              <span class="dd__cta-text">Not sure which service fits your property?</span>
              <span class="dd__cta-link">Get in touch →</span>
            </a>
          </div>
        </div>
      </div>
    </nav>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Menu"
      data-menu-toggle
    >
      <span></span><span></span>
    </button>

    <a class="logo" href={routes.home} aria-label="Indigo Interiors, home">
      <span>Indigo</span><span>Interiors</span>
    </a>

    <div class="bar__end">
      <a class="cta" href={routes.contact}>Get in touch</a>
    </div>
  </div>

  <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile" data-menu>
    <div class="mm">
      <ul role="list" class="mm__primary">
        {
          mobilePrimary.map((p, i) => (
            <li class="mm__item" style={`--i: ${i}`}>
              <a class="mm__link" href={p.href} aria-current={isCurrent(p.href) ? 'page' : undefined}>
                {p.label}
                <span class="mm__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="mm__label mm__item" style="--i: 3" id="mm-services-label">Services</p>
      <ul role="list" class="mm__services" aria-labelledby="mm-services-label">
        {
          services.map((s, i) => (
            <li class="mm__item" style={`--i: ${4 + i}`}>
              <a
                class="mm__svc"
                href={serviceHref(s.slug)}
                aria-current={isCurrent(serviceHref(s.slug)) ? 'page' : undefined}
              >
                <span class="mm__thumb">
                  <Image src={s.image} alt="" widths={[112, 224]} sizes="56px" loading="lazy" />
                </span>
                <span class="mm__text">
                  <span class="mm__num">{s.num}</span>
                  <span class="mm__title">{s.cardTitle}</span>
                  <span class="mm__tag">{s.tagline}</span>
                </span>
                <span class="mm__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mm__contact mm__item" style="--i: 7">
        <a class="mm__contact-row" href={site.phone.href}>
          <span><span class="mm__contact-label">Call us</span>{site.phone.display}</span>
          <span class="mm__contact-icon" aria-hidden="true">↗</span>
        </a>
        <a class="mm__contact-row" href={`mailto:${site.email}`}>
          <span><span class="mm__contact-label">Email us</span>{site.email}</span>
          <span class="mm__contact-icon" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;

  // Services dropdown: opens on hover for mouse users, toggles on click for touch and keyboard.
  const dropdown = header.querySelector<HTMLElement>('[data-dropdown]')!;
  const trigger = dropdown.querySelector<HTMLButtonElement>('[data-dropdown-trigger]')!;
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
  let closeTimer: number | undefined;

  const isOpen = () => trigger.getAttribute('aria-expanded') === 'true';
  const setDropdown = (open: boolean) => {
    window.clearTimeout(closeTimer);
    trigger.setAttribute('aria-expanded', String(open));
    dropdown.toggleAttribute('data-open', open);
  };

  // A mouse click lands after mouseenter has already opened the panel, so it must not toggle it shut.
  // Keyboard activation (detail === 0) and touch still toggle.
  trigger.addEventListener('click', (e) => {
    if (canHover.matches && e.detail > 0) setDropdown(true);
    else setDropdown(!isOpen());
  });
  dropdown.addEventListener('mouseenter', () => {
    if (canHover.matches) setDropdown(true);
  });
  dropdown.addEventListener('mouseleave', () => {
    if (!canHover.matches) return;
    closeTimer = window.setTimeout(() => setDropdown(false), 160);
  });
  dropdown.addEventListener('focusout', (e) => {
    if (!dropdown.contains(e.relatedTarget as Node | null)) setDropdown(false);
  });
  document.addEventListener('pointerdown', (e) => {
    if (isOpen() && !dropdown.contains(e.target as Node)) setDropdown(false);
  });

  // Mobile menu: open state lives on the header ([data-menu-open]) so CSS can animate it in and out
  const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const menu = header.querySelector<HTMLElement>('[data-menu]')!;
  const backdrop = header.querySelector<HTMLElement>('[data-menu-backdrop]')!;
  const menuIsOpen = () => header.hasAttribute('data-menu-open');

  const setMenu = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Menu');
    header.toggleAttribute('data-menu-open', open);
    document.documentElement.classList.toggle('menu-open', open); // locks page scroll
  };

  toggle.addEventListener('click', () => setMenu(!menuIsOpen()));
  backdrop.addEventListener('click', () => setMenu(false));
  // Close after choosing a link (matters for same-page links and when the page is restored from the back/forward cache)
  menu.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) setMenu(false);
  });
  window.addEventListener('pageshow', () => setMenu(false));
  window.matchMedia('(min-width: 900px)').addEventListener('change', (e) => {
    if (e.matches) setMenu(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (isOpen()) {
      setDropdown(false);
      trigger.focus();
    }
    if (menuIsOpen()) {
      setMenu(false);
      toggle.focus();
    }
  });
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding: 14px var(--page-pad);
  }

  .bar {
    position: relative;
    max-width: var(--container-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    padding: 10px 12px;
    border-radius: var(--radius-pill);
    background: rgb(245 243 238 / 0.82);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border: 1px solid rgb(20 32 30 / 0.08);
    box-shadow: var(--shadow-header);
  }

  /* Logo wordmark */
  .logo {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    line-height: 0.86;
    font-weight: var(--weight-thin);
    font-size: 32px;
    letter-spacing: 0.02em;
    color: var(--color-teal);
    text-transform: uppercase;
    min-height: 44px;
    justify-content: center;
  }

  .bar__end {
    grid-column: 3;
    justify-self: end;
    display: flex;
    align-items: center;
  }

  .cta {
    background: var(--color-teal);
    color: var(--color-white);
    padding: 12px 22px;
    border-radius: var(--radius-pill);
    font-size: 15px;
    font-weight: var(--weight-semibold);
    white-space: nowrap;
    transition: background-color var(--dur-base);
  }

  .cta:hover {
    background: var(--color-teal-deep);
    color: var(--color-white);
  }

  /* Narrow: hamburger on the left */
  .nav {
    display: none;
  }

  .menu-toggle {
    grid-column: 1;
    grid-row: 1;
    justify-self: start;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    border: 1px solid rgb(20 32 30 / 0.15);
    background: transparent;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }

  /* Two lines that rotate into an X */
  .menu-toggle span {
    width: 16px;
    height: 1.5px;
    background: var(--color-ink);
    transition: transform 0.35s var(--ease-out);
  }

  .menu-toggle[aria-expanded='true'] span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  :global(html.menu-open) {
    overflow: hidden;
  }

  /* Dims and softens the page behind the open menu; tapping it closes the menu */
  .menu-backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: rgb(20 32 30 / 0.28);
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.25s ease,
      visibility 0.25s;
  }

  .site-header[data-menu-open] .menu-backdrop {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.35s ease,
      visibility 0s;
  }

  /*
    Mobile menu. Closed: invisible, nudged up and slightly smaller (out of the tab order via visibility).
    Opening: fades and settles into place while the rows rise in one after another.
    Closing: a quicker fade with no stagger.
  */
  .mobile-menu {
    max-width: var(--container-max);
    margin: 10px auto 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-10px) scale(0.98);
    transform-origin: 50% 0;
    transition:
      opacity 0.2s ease,
      transform 0.3s ease,
      visibility 0.2s;
  }

  .site-header[data-menu-open] .mobile-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
    transition:
      opacity 0.28s ease,
      transform 0.5s var(--ease-out),
      visibility 0s;
  }

  .mm {
    background: var(--color-white);
    border-radius: var(--radius-card);
    padding: 10px;
    box-shadow: var(--shadow-menu);
    border: 1px solid rgb(20 32 30 / 0.06);
    max-height: calc(100dvh - 120px);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .mm__item {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.2s ease,
      transform 0.3s ease;
  }

  .site-header[data-menu-open] .mm__item {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.35s ease calc(0.06s + var(--i) * 0.035s),
      transform 0.5s var(--ease-out) calc(0.06s + var(--i) * 0.035s);
  }

  .mm__arrow {
    color: var(--color-muted);
    font-size: 16px;
    transition:
      color var(--dur-base),
      transform 0.35s var(--ease-out);
  }

  /* Main pages */
  .mm__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 16px;
    border-radius: 18px;
    font-size: 22px;
    font-weight: var(--weight-medium);
    letter-spacing: -0.01em;
    color: var(--color-ink);
    transition: background-color var(--dur-fast);
  }

  .mm__link:hover,
  .mm__link:active {
    background: var(--color-stone);
    color: var(--color-ink);
  }

  .mm__link[aria-current='page'] {
    color: var(--color-teal);
  }

  .mm__link[aria-current='page'] .mm__arrow,
  .mm__link:hover .mm__arrow {
    color: var(--color-teal);
    transform: translateX(3px);
  }

  /* Services */
  .mm__label {
    margin: 6px 6px 0;
    padding: 16px 10px 8px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }

  .mm__services {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .mm__svc {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 8px 14px 8px 8px;
    border-radius: 18px;
    color: var(--color-ink);
    transition: background-color var(--dur-fast);
  }

  .mm__svc:hover,
  .mm__svc:active,
  .mm__svc[aria-current='page'] {
    background: var(--color-cream);
    color: var(--color-ink);
  }

  .mm__svc:hover .mm__arrow,
  .mm__svc[aria-current='page'] .mm__arrow {
    color: var(--color-teal);
    transform: translateX(3px);
  }

  .mm__thumb {
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 14px;
    overflow: hidden;
    background: var(--color-placeholder);
  }

  .mm__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mm__text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .mm__num {
    font-size: 12px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.04em;
    color: var(--color-teal);
  }

  .mm__title {
    font-size: 16px;
    font-weight: var(--weight-semibold);
    line-height: 1.2;
  }

  .mm__tag {
    font-size: 13px;
    line-height: 1.35;
    color: var(--color-muted);
  }

  /* Contact strip */
  .mm__contact {
    margin-top: 10px;
    padding: 4px;
    border-radius: 20px;
    background: var(--color-cream);
    display: grid;
  }

  .mm__contact-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 16px;
    font-size: 16px;
    font-weight: var(--weight-semibold);
    color: var(--color-ink);
    transition: background-color var(--dur-fast);
  }

  .mm__contact-row + .mm__contact-row {
    border-top: 1px solid var(--line);
    border-radius: 0 0 16px 16px;
  }

  .mm__contact-row:hover,
  .mm__contact-row:active {
    background: var(--color-cream-hover);
    color: var(--color-ink);
  }

  .mm__contact-label {
    display: block;
    font-size: 13px;
    font-weight: var(--weight-medium);
    color: var(--color-muted);
  }

  .mm__contact-icon {
    color: var(--color-teal);
    font-size: 18px;
  }

  /* Wide: inline nav */
  @media (min-width: 900px) {
    .menu-toggle,
    .mobile-menu,
    .menu-backdrop {
      display: none;
    }

    .nav {
      grid-column: 1;
      grid-row: 1;
      justify-self: start;
      align-self: stretch; /* full bar height, so the dropdown is measured from the bar's edge */
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 15px;
      font-weight: var(--weight-medium);
    }

    .dd {
      align-self: stretch;
      display: flex;
      align-items: center;
    }
  }

  .nav__item {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 10px 16px;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-ink);
    font-size: 15px;
    font-weight: var(--weight-medium);
    line-height: 1.5;
    transition:
      background-color var(--dur-base),
      color var(--dur-base);
  }

  .nav__item:hover {
    background: var(--color-teal-tint);
    color: var(--color-ink);
  }

  .nav__item[aria-current='page'],
  .nav__item.is-active {
    background: var(--color-teal-tint);
    color: var(--color-teal);
  }

  /* Services dropdown */
  .dd__trigger {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .dd__trigger[aria-expanded='true'] {
    background: var(--color-teal-tint);
  }

  .dd__chevron {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    margin-top: -3px;
    transform: rotate(45deg);
    transition: transform 0.35s var(--ease-out);
  }

  .dd__trigger[aria-expanded='true'] .dd__chevron {
    transform: translateY(3px) rotate(-135deg);
  }

  /* Below 1100px the panel spans the whole header bar; above it, it anchors to the trigger. */
  .dd__panel {
    position: absolute;
    top: calc(100% - 10px); /* start inside the bar's padding so the hover area meets the Services item */
    left: 0;
    right: 0;
    /* Gap below the bar; the padding doubles as a hover bridge so the menu doesn't close on the way down */
    padding-top: 23px; /* 12px gap below the bar + its 10px padding and 1px border */
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(10px) scale(0.97);
    transform-origin: 24px 0;
    transition:
      opacity 0.28s ease,
      transform 0.5s var(--ease-out),
      visibility 0.28s;
  }

  .dd[data-open] .dd__panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
  }

  .dd__card {
    background: var(--color-white);
    border-radius: var(--radius-card);
    padding: 10px;
    width: 100%;
    max-width: calc(100vw - 32px);
    margin: 0 auto;
    box-shadow: var(--shadow-dropdown);
    border: 1px solid rgb(20 32 30 / 0.06);
  }

  @media (min-width: 1100px) {
    .dd {
      position: relative;
    }

    .dd__panel {
      left: -8px;
      right: auto;
      top: 100%;
    }

    .dd__card {
      width: 760px;
    }
  }

  .dd__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .dd__item {
    border-radius: var(--radius-media);
    padding: 6px 6px 14px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    opacity: 0;
    transform: translateY(8px);
    transition:
      background-color var(--dur-base),
      opacity 0.4s ease,
      transform 0.5s var(--ease-out);
  }

  /* Cards rise in one after another as the panel opens */
  .dd[data-open] .dd__item {
    opacity: 1;
    transform: none;
    transition-delay: 0s, calc(0.06s + var(--i) * 0.05s), calc(0.06s + var(--i) * 0.05s);
  }

  .dd__item:hover,
  .dd__item:focus-visible,
  .dd__item[aria-current='page'] {
    background: var(--color-cream);
  }

  .dd__media {
    display: block;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .dd__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-zoom) var(--ease-media);
  }

  .dd__item:hover .dd__media img,
  .dd__item:focus-visible .dd__media img {
    transform: scale(1.06);
  }

  .dd__text {
    padding: 0 8px;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .dd__num {
    font-size: 12px;
    font-weight: var(--weight-bold);
    color: var(--color-teal);
    letter-spacing: 0.04em;
  }

  .dd__title {
    font-size: 16px;
    font-weight: var(--weight-semibold);
    color: var(--color-ink);
    line-height: 1.2;
  }

  .dd__tag {
    font-size: 14px;
    color: var(--color-muted);
    line-height: 1.35;
  }

  .dd__cta {
    margin-top: 8px;
    padding: 14px 18px;
    border-radius: 18px;
    background: var(--color-cream);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    transition: background-color var(--dur-base);
  }

  .dd__cta:hover {
    background: var(--color-cream-hover);
  }

  .dd__cta-text {
    font-size: 14px;
    color: var(--color-ink-soft);
    font-weight: var(--weight-medium);
  }

  .dd__cta-link {
    font-size: 14px;
    font-weight: var(--weight-bold);
    color: var(--color-teal);
    white-space: nowrap;
  }

  /* ---- Small-screen overrides: kept last so they always beat the base rules above ---- */

  /* Small phones: equal side columns are too narrow for the CTA, so let them size to content */
  @media (max-width: 479px) {
    .bar {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 8px;
    }

    .cta {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 11px 16px;
      font-size: 14px;
    }
  }

  /* Small phones: the logo shares the bar with the menu button and "Get in touch" */
  @media (max-width: 479px) {
    .logo {
      font-size: 25px;
    }
  }

  /*
    The smallest phones (under 360px) don't have room for all three, so the CTA steps aside
