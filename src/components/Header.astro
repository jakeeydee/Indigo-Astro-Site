---
import { Image } from 'astro:assets';
import { allPages, routes, services, serviceHref } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href;
const inServices = path.startsWith('/services/');
---

<header class="site-header" data-header>
  <div class="bar">
    <nav class="nav" aria-label="Primary">
      <a class="nav__item" href={routes.home} aria-current={isCurrent(routes.home) ? 'page' : undefined}>Home</a>
      <a class="nav__item" href={routes.about} aria-current={isCurrent(routes.about) ? 'page' : undefined}>About Us</a>

      <div class="dd" data-dropdown>
        <button
          class:list={['nav__item', 'dd__trigger', { 'is-active': inServices }]}
          type="button"
          aria-expanded="false"
          aria-controls="services-menu"
          data-dropdown-trigger
        >
          Services <span class="dd__chevron" aria-hidden="true"></span>
        </button>

        <div class="dd__panel" id="services-menu" data-dropdown-panel>
          <div class="dd__card">
            <ul role="list" class="dd__grid">
              {
                services.map((s, i) => (
                  <li>
                    <a
                      class="dd__item"
                      style={`--i: ${i}`}
                      href={serviceHref(s.slug)}
                      aria-current={isCurrent(serviceHref(s.slug)) ? 'page' : undefined}
                    >
                      <span class="dd__media">
                        <Image
                          src={s.image}
                          alt=""
                          widths={[240, 480]}
                          sizes="240px"
                          loading="eager"
                          fetchpriority="low"
                        />
                      </span>
                      <span class="dd__text">
                        <span class="dd__num">{s.num}</span>
                        <span class="dd__title">{s.cardTitle}</span>
                        <span class="dd__tag">{s.tagline}</span>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
            <a class="dd__cta" href={routes.contact}>
              <span class="dd__cta-text">Not sure which service fits your property?</span>
              <span class="dd__cta-link">Get in touch →</span>
            </a>
          </div>
        </div>
      </div>
    </nav>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Menu"
      data-menu-toggle
    >
      <span></span><span></span>
    </button>

    <a class="logo" href={routes.home} aria-label="Indigo Interiors, home">
      <span>Indigo</span><span>Interiors</span>
    </a>

    <div class="bar__end">
      <a class="cta" href={routes.contact}>Get in touch</a>
    </div>
  </div>

  <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile" hidden data-menu>
    <ul role="list">
      {
        allPages.map((p) => (
          <li>
            <a href={p.href} aria-current={isCurrent(p.href) ? 'page' : undefined}>
              {p.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;

  // Services dropdown: opens on hover for mouse users, toggles on click for touch and keyboard.
  const dropdown = header.querySelector<HTMLElement>('[data-dropdown]')!;
  const trigger = dropdown.querySelector<HTMLButtonElement>('[data-dropdown-trigger]')!;
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
  let closeTimer: number | undefined;

  const isOpen = () => trigger.getAttribute('aria-expanded') === 'true';
  const setDropdown = (open: boolean) => {
    window.clearTimeout(closeTimer);
    trigger.setAttribute('aria-expanded', String(open));
    dropdown.toggleAttribute('data-open', open);
  };

  // A mouse click lands after mouseenter has already opened the panel, so it must not toggle it shut.
  // Keyboard activation (detail === 0) and touch still toggle.
  trigger.addEventListener('click', (e) => {
    if (canHover.matches && e.detail > 0) setDropdown(true);
    else setDropdown(!isOpen());
  });
  dropdown.addEventListener('mouseenter', () => {
    if (canHover.matches) setDropdown(true);
  });
  dropdown.addEventListener('mouseleave', () => {
    if (!canHover.matches) return;
    closeTimer = window.setTimeout(() => setDropdown(false), 160);
  });
  dropdown.addEventListener('focusout', (e) => {
    if (!dropdown.contains(e.relatedTarget as Node | null)) setDropdown(false);
  });
  document.addEventListener('pointerdown', (e) => {
    if (isOpen() && !dropdown.contains(e.target as Node)) setDropdown(false);
  });

  // Mobile menu
  const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const menu = header.querySelector<HTMLElement>('[data-menu]')!;

  const setMenu = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Menu');
    menu.hidden = !open;
  };

  toggle.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
  window.matchMedia('(min-width: 900px)').addEventListener('change', (e) => {
    if (e.matches) setMenu(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (isOpen()) {
      setDropdown(false);
      trigger.focus();
    }
    if (!menu.hidden) {
      setMenu(false);
      toggle.focus();
    }
  });
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding: 14px var(--page-pad);
  }

  .bar {
    position: relative;
    max-width: var(--container-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    padding: 10px 12px;
    border-radius: var(--radius-pill);
    background: rgb(245 243 238 / 0.82);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border: 1px solid rgb(20 32 30 / 0.08);
    box-shadow: var(--shadow-header);
  }

  /* Small phones: equal side columns are too narrow for the CTA, so let them size to content */
  @media (max-width: 479px) {
    .bar {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 8px;
    }

    .cta {
      padding: 11px 16px;
      font-size: 14px;
    }
  }

  /* Logo wordmark */
  .logo {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    line-height: 0.86;
    font-weight: var(--weight-thin);
    font-size: 21px;
    letter-spacing: 0.02em;
    color: var(--color-teal);
    text-transform: uppercase;
  }

  .bar__end {
    grid-column: 3;
    justify-self: end;
    display: flex;
    align-items: center;
  }

  .cta {
    background: var(--color-teal);
    color: var(--color-white);
    padding: 12px 22px;
    border-radius: var(--radius-pill);
    font-size: 15px;
    font-weight: var(--weight-semibold);
    white-space: nowrap;
    transition: background-color var(--dur-base);
  }

  .cta:hover {
    background: var(--color-teal-deep);
    color: var(--color-white);
  }

  /* Narrow: hamburger on the left */
  .nav {
    display: none;
  }

  .menu-toggle {
    grid-column: 1;
    grid-row: 1;
    justify-self: start;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    border: 1px solid rgb(20 32 30 / 0.15);
    background: transparent;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }

  .menu-toggle span {
    width: 16px;
    height: 1.5px;
    background: var(--color-ink);
  }

  .mobile-menu {
    max-width: var(--container-max);
    margin: 10px auto 0;
    background: var(--color-white);
    border-radius: var(--radius-card);
    padding: 12px;
    box-shadow: var(--shadow-menu);
  }

  .mobile-menu ul {
    display: flex;
    flex-direction: column;
  }

  .mobile-menu a {
    display: block;
    padding: 14px 16px;
    font-size: 20px;
    font-weight: var(--weight-medium);
    border-radius: 16px;
    color: var(--color-ink);
    transition: background-color var(--dur-fast);
  }

  .mobile-menu a:hover {
    background: var(--color-stone);
  }

  .mobile-menu a[aria-current='page'] {
    color: var(--color-teal);
  }

  /* Wide: inline nav */
  @media (min-width: 900px) {
    .menu-toggle,
    .mobile-menu {
      display: none;
    }

    .nav {
      grid-column: 1;
      grid-row: 1;
      justify-self: start;
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 15px;
      font-weight: var(--weight-medium);
    }
  }

  .nav__item {
    padding: 10px 16px;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-ink);
    font-size: 15px;
    font-weight: var(--weight-medium);
    line-height: 1.5;
    transition:
      background-color var(--dur-base),
      color var(--dur-base);
  }

  .nav__item:hover {
    background: var(--color-teal-tint);
    color: var(--color-ink);
  }

  .nav__item[aria-current='page'],
  .nav__item.is-active {
    background: var(--color-teal-tint);
    color: var(--color-teal);
  }

  /* Services dropdown */
  .dd__trigger {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .dd__trigger[aria-expanded='true'] {
    background: var(--color-teal-tint);
  }

  .dd__chevron {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    margin-top: -3px;
    transform: rotate(45deg);
    transition: transform 0.35s var(--ease-out);
  }

  .dd__trigger[aria-expanded='true'] .dd__chevron {
    transform: translateY(3px) rotate(-135deg);
  }

  /* Below 1100px the panel spans the whole header bar; above it, it anchors to the trigger. */
  .dd__panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    padding-top: 14px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(10px) scale(0.97);
    transform-origin: 24px 0;
    transition:
      opacity 0.28s ease,
      transform 0.5s var(--ease-out),
      visibility 0.28s;
  }

  .dd[data-open] .dd__panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
  }

  .dd__card {
    background: var(--color-white);
    border-radius: var(--radius-card);
    padding: 10px;
    width: 100%;
    max-width: calc(100vw - 32px);
    margin: 0 auto;
    box-shadow: var(--shadow-dropdown);
    border: 1px solid rgb(20 32 30 / 0.06);
  }

  @media (min-width: 1100px) {
    .dd {
      position: relative;
    }

    .dd__panel {
      left: -8px;
      right: auto;
    }

    .dd__card {
      width: 760px;
    }
  }

  .dd__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .dd__item {
    border-radius: var(--radius-media);
    padding: 6px 6px 14px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    opacity: 0;
    transform: translateY(8px);
    transition:
      background-color var(--dur-base),
      opacity 0.4s ease,
      transform 0.5s var(--ease-out);
  }

  /* Cards rise in one after another as the panel opens */
  .dd[data-open] .dd__item {
    opacity: 1;
    transform: none;
    transition-delay: 0s, calc(0.06s + var(--i) * 0.05s), calc(0.06s + var(--i) * 0.05s);
  }

  .dd__item:hover,
  .dd__item:focus-visible,
  .dd__item[aria-current='page'] {
    background: var(--color-cream);
  }

  .dd__media {
    display: block;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .dd__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-zoom) var(--ease-media);
  }

  .dd__item:hover .dd__media img,
  .dd__item:focus-visible .dd__media img {
    transform: scale(1.06);
  }

  .dd__text {
    padding: 0 8px;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .dd__num {
    font-size: 12px;
    font-weight: var(--weight-bold);
    color: var(--color-teal);
    letter-spacing: 0.04em;
  }

  .dd__title {
    font-size: 16px;
    font-weight: var(--weight-semibold);
    color: var(--color-ink);
    line-height: 1.2;
  }

  .dd__tag {
    font-size: 14px;
    color: var(--color-muted);
    line-height: 1.35;
  }

  .dd__cta {
    margin-top: 8px;
    padding: 14px 18px;
    border-radius: 18px;
    background: var(--color-cream);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    transition: background-color var(--dur-base);
  }

  .dd__cta:hover {
    background: var(--color-cream-hover);
  }

  .dd__cta-text {
    font-size: 14px;
    color: var(--color-ink-soft);
    font-weight: var(--weight-medium);
  }

  .dd__cta-link {
    font-size: 14px;
    font-weight: var(--weight-bold);
    color: var(--color-teal);
    white-space: nowrap;
  }
</style>
