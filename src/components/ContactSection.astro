---
/*
  Contact details + form, posting to Web3Forms (https://web3forms.com).
  The access key is public by design and is read from PUBLIC_WEB3FORMS_KEY at build time.
  With JavaScript the form submits in place and shows a thank-you state;
  without it, the browser posts normally and Web3Forms shows its own confirmation page.
*/
import { site } from '../data/site';

interface Props {
  /** Heading level: h2 on Home, h1 on the Contact page. */
  as?: 'h1' | 'h2';
}

const { as: Heading = 'h2' } = Astro.props;
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
---

<section class="section" id="contact" aria-labelledby="contact-heading">
  <div class="container grid">
    <div class="details">
      <Heading id="contact-heading" class="heading">Contact Us</Heading>
      <div class="rows">
        <a class="row" href={`mailto:${site.email}`}>
          <span class="row__text">
            <span class="row__label">Email</span>
            <span class="row__value">{site.email}</span>
          </span>
          <span class="row__icon" aria-hidden="true">↗</span>
        </a>
        <a class="row" href={site.phone.href}>
          <span class="row__text">
            <span class="row__label">Phone</span>
            <span class="row__value">{site.phone.display}</span>
          </span>
          <span class="row__icon" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <div class="card" data-contact>
      <div class="sent" hidden data-sent tabindex="-1">
        <div class="tick" aria-hidden="true">✓</div>
        <p class="sent__title">Thanks<span data-sent-name></span>.</p>
        <p class="sent__body">Your message has been sent. We’ll be in touch soon.</p>
        <button class="sent__again" type="button" data-reset>Send another</button>
      </div>

      <form class="form" action="https://api.web3forms.com/submit" method="POST" data-form>
        <input type="hidden" name="access_key" value={accessKey} />
        <input type="hidden" name="from_name" value="Indigo Interiors website" />
        <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <label class="field">
          First name *
          <input required name="first_name" autocomplete="given-name" />
        </label>
        <label class="field">
          Last name *
          <input required name="last_name" autocomplete="family-name" />
        </label>
        <label class="field field--full">
          Email *
          <input required type="email" name="email" autocomplete="email" />
        </label>
        <label class="field field--full">
          Subject *
          <input required name="subject" />
        </label>
        <label class="field field--full">
          Message *
          <textarea required name="message" rows="4"></textarea>
        </label>

        <p class="error field--full" role="alert" hidden data-error>
          Sorry, your message couldn’t be sent. Please try again, or email us at <a href={`mailto:${site.email}`}
            >{site.email}</a
          >.
        </p>

        <button class="btn btn--teal submit" type="submit" data-submit>Submit</button>
      </form>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-contact]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const sent = root.querySelector<HTMLElement>('[data-sent]')!;
    const nameSlot = root.querySelector<HTMLElement>('[data-sent-name]')!;
    const error = root.querySelector<HTMLElement>('[data-error]')!;
    const submit = root.querySelector<HTMLButtonElement>('[data-submit]')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      error.hidden = true;
      submit.disabled = true;
      submit.textContent = 'Sending…';

      const data = new FormData(form);
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || !json.success) throw new Error(json.message || res.statusText);

        const first = String(data.get('first_name') || '').trim();
        nameSlot.textContent = first ? `, ${first}` : '';
        form.reset();
        form.hidden = true;
        sent.hidden = false;
        sent.focus();
      } catch {
        error.hidden = false;
      } finally {
        submit.disabled = false;
        submit.textContent = 'Submit';
      }
    });

    root.querySelector('[data-reset]')!.addEventListener('click', () => {
      sent.hidden = true;
      form.hidden = false;
      form.querySelector<HTMLInputElement>('input[name="first_name"]')!.focus();
    });
  });
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    gap: clamp(32px, 5vw, 80px);
  }

  .details {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .heading {
    font-size: clamp(44px, 6vw, 88px);
    line-height: 0.95;
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-display);
  }

  .rows {
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-top: 1px solid var(--line);
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
    color: var(--color-ink);
  }

  .row:hover {
    color: var(--color-teal);
  }

  .row__text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .row__label {
    font-size: 14px;
    color: var(--color-muted);
    font-weight: var(--weight-medium);
  }

  .row__value {
    font-size: clamp(19px, 1.8vw, 24px);
    font-weight: var(--weight-medium);
  }

  .row__icon {
    color: var(--color-teal);
    font-size: 20px;
  }

  .card {
    background: var(--color-white);
    border-radius: 32px;
    padding: clamp(24px, 3.5vw, 44px);
  }

  .form {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 22px 20px;
  }

  .form[hidden] {
    display: none;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 14px;
    font-weight: var(--weight-semibold);
    color: var(--color-teal);
  }

  .field--full {
    grid-column: 1 / -1;
  }

  .field input,
  .field textarea {
    border: 0;
    border-bottom: 1px solid var(--line-strong);
    border-radius: 0;
    background: transparent;
    padding: 10px 0;
    font-size: 17px;
    font-weight: var(--weight-regular);
    color: var(--color-ink);
    outline: none;
  }

  .field textarea {
    resize: vertical;
  }

  .field input:focus,
  .field textarea:focus {
    border-bottom-color: var(--color-teal);
  }

  .error {
    font-size: 15px;
    color: #a32d2d;
  }

  .submit {
    grid-column: 1 / -1;
    justify-self: start;
    padding: 16px 34px;
  }

  .submit:disabled {
    opacity: 0.7;
    cursor: progress;
  }

  .sent {
    min-height: 380px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
    outline: none;
  }

  .sent[hidden] {
    display: none;
  }

  .tick {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-teal);
    color: var(--color-white);
    display: grid;
    place-items: center;
    font-size: 24px;
  }

  .sent__title {
    font-size: 30px;
    font-weight: var(--weight-medium);
  }

  .sent__body {
    font-size: 17px;
    color: var(--color-muted);
  }

  .sent__again {
    align-self: flex-start;
    margin-top: 10px;
    padding: 0;
    border: 0;
    background: none;
    font-weight: var(--weight-semibold);
    color: var(--color-teal);
  }
</style>
