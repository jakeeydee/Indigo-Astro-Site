---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import foundersImage from '../assets/images/founders.jpg';
import { videos } from '../data/site';
---

<BaseLayout
  title="About Us"
  description="Indigo Interiors was founded in March 2000 by husband-and-wife team Russell Lowy and Janine Helfgott Lowy, specialists in interiors for property investment."
>
  <section class="intro">
    <div class="container">
      <p class="kicker">About Us</p>
      <h1>A Trusted Name in Interiors Since 2000</h1>
      <p class="lede">
        Indigo Interiors was founded in March 2000 by husband-and-wife team Russell Lowy and Janine Helfgott Lowy. Janine
        originally established the business, and Russell soon joined her, bringing their combined expertise to the world
        of interiors for property investment.
      </p>
    </div>
  </section>

  <section class="block" aria-labelledby="founders-heading">
    <div class="container">
      <h2 id="founders-heading">Our Co-Founders</h2>
      <div class="founders">
        <div class="photo">
          <Image
            src={foundersImage}
            alt="Janine Helfgott Lowy and Russell Lowy"
            widths={[480, 720, 960, 1280]}
            sizes="(min-width: 760px) 50vw, 100vw"
          />
        </div>
        <div class="quotes">
          <figure class="quote quote--teal">
            <blockquote>
              "We love what we do, and that passion drives our success. This isn’t just a business - it’s our
              livelihood, and that’s why we put everything into it."
            </blockquote>
            <figcaption>Janine Helfgott Lowy</figcaption>
          </figure>
          <figure class="quote quote--white">
            <blockquote>
              "We’re straightforward, reliable, and always deliver on our promises. Our service is personal, our
              turnaround is fast, and we take great pride in the relationships we’ve built over the years."
            </blockquote>
            <figcaption>Russell Lowy</figcaption>
          </figure>
        </div>
      </div>

      <div class="story">
        <p>
          Janine’s journey in the property industry began in the late 1980s, where she spent a decade in lettings and
          property management. During this time, she developed a deep understanding of what makes a property both
          functional and appealing to investors. Her experience in helping clients refurbish and enhance their properties
          naturally led her into interiors. After working for a company for three years, a shift in their direction
          presented the perfect opportunity for Janine and Russell to launch Indigo Interiors.
        </p>
        <p>
          Russell’s background in sales and property investment, dating back to the 1980s, complemented Janine’s
          expertise. Together, their extensive knowledge of the property investment market has been the foundation of
          their success. Their hands-on approach ensures that every client receives a service tailored to their needs,
          with meticulous attention to detail and efficiency.
        </p>
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="videos-heading">
    <div class="container">
      <h2 id="videos-heading">Watch our videos</h2>
      <ul role="list" class="videos">
        {
          videos.map((v) => (
            <li class="video-item">
              <VideoEmbed id={v.id} title={v.title} thumbnail={v.thumbnail} />
              <div class="video-meta">
                <p class="eyebrow">{v.eyebrow}</p>
                <h3>{v.title}</h3>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    padding: clamp(32px, 6vw, 80px) var(--page-pad) 0;
  }

  .kicker {
    font-size: 15px;
    font-weight: var(--weight-semibold);
    color: var(--color-teal);
    margin-bottom: 18px;
  }

  h1 {
    margin-bottom: clamp(28px, 4vw, 48px);
    font-size: clamp(44px, 7vw, 104px);
    line-height: 0.95;
    letter-spacing: var(--tracking-display);
    max-width: 14ch;
  }

  .lede {
    max-width: 760px;
    font-size: clamp(19px, 1.7vw, 24px);
    line-height: 1.5;
    color: var(--color-ink-soft);
  }

  .block {
    padding: clamp(64px, 9vw, 120px) var(--page-pad) 0;
  }

  h2 {
    margin-bottom: 36px;
    font-size: clamp(34px, 4vw, 56px);
    letter-spacing: var(--tracking-heading);
    line-height: 1.1;
  }

  .founders {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 20px;
  }

  .photo {
    border-radius: 32px;
    overflow: hidden;
    min-height: 440px;
    background: #dde6e3;
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .quotes {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .quote {
    flex: 1;
    border-radius: 32px;
    padding: clamp(26px, 3vw, 40px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
  }

  .quote blockquote {
    font-size: clamp(19px, 1.6vw, 23px);
    line-height: 1.45;
  }

  .quote figcaption {
    font-weight: var(--weight-semibold);
  }

  .quote--teal {
    background: var(--color-teal);
    color: var(--color-white);
  }

  .quote--white {
    background: var(--color-white);
  }

  .quote--white figcaption {
    color: var(--color-teal);
  }

  .story {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: clamp(24px, 4vw, 64px);
    margin-top: clamp(48px, 6vw, 80px);
  }

  .story p {
    font-size: 18px;
    line-height: 1.65;
    color: var(--color-ink-soft);
  }

  .videos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 20px;
  }

  .video-item {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .video-meta {
    padding: 0 6px;
  }

  .video-meta .eyebrow {
    margin-bottom: 6px;
  }

  h3 {
    font-size: 22px;
    font-weight: var(--weight-medium);
    line-height: 1.3;
  }
</style>
