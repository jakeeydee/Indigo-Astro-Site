---
import type { GetStaticPaths } from 'astro';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/Gallery.astro';
import { services, serviceHref, galleryFor, routes, type Service } from '../../data/site';

export const getStaticPaths = (() =>
  services.map((service) => ({ params: { slug: service.slug }, props: { service } }))) satisfies GetStaticPaths;

interface Props {
  service: Service;
}

const { service } = Astro.props;
const gallery = galleryFor(service.slug);
const serviceOrder = services.map((s) => s.slug);

// Same widths/sizes as the feature <Image> below, so these URLs match what the other pages request
const featureWidths = [480, 720, 960, 1280];
const featureSizes = '(min-width: 900px) 50vw, 100vw';
const otherFeatures = await Promise.all(
  services
    .filter((s) => s.slug !== service.slug)
    .map((s) => getImage({ src: s.image, widths: featureWidths })),
);
---

<BaseLayout title={service.title} description={service.body[0]}>
  <!--
    Tags the cross-document view transition as "forward" or "backward" so the content slides
    the right way. Inline and in <head> so it runs before the first paint, when pagereveal fires.
  -->
  <script slot="head" is:inline define:vars={{ serviceOrder }}>
    window.addEventListener('pagereveal', (e) => {
      const from = window.navigation?.activation?.from?.url;
      const to = window.navigation?.activation?.entry?.url;
      if (!e.viewTransition || !from || !to) return;
      const index = (url) => serviceOrder.findIndex((slug) => new URL(url).pathname.includes(`/services/${slug}/`));
      const a = index(from);
      const b = index(to);
      if (a < 0 || b < 0 || a === b) return;
      e.viewTransition.types.add(b > a ? 'forward' : 'backward');
    });
  </script>

  <section class="service">
    <div class="container">
      <nav aria-label="Services">
        <ol role="list" class="tabs">
          {
            services.map((s) => (
              <li>
                <a
                  class="tab"
                  href={serviceHref(s.slug)}
                  aria-current={s.slug === service.slug ? 'page' : undefined}
                >
                  <span class="tab__num" aria-hidden="true">{s.num}</span>
                  <span class="tab__label tab__label--full">{s.cardTitle}</span>
                  <span class="tab__label tab__label--short" aria-hidden="true">{s.tabLabel}</span>
                  {s.slug === service.slug && <span class="tab__bar" aria-hidden="true" />}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="split">
        <div class="copy">
          <h1>{service.title}</h1>
          <p class="sub">{service.subtitle}</p>
          {service.body.map((para) => <p class="para">{para}</p>)}
          <a class="btn btn--ink" href={routes.contact}>Get in touch</a>
        </div>
        <div class="feature">
          <Image
            src={service.image}
            alt={service.imageAlt}
            widths={featureWidths}
            sizes={featureSizes}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>

      <h2>Gallery</h2>
      <Gallery images={gallery} label={service.title} />
    </div>
  </section>

  <!-- The other services' feature photos, fetched once this page is idle so switching tabs never waits on them -->
  <template data-preload-features>
    {otherFeatures.map((img) => <img srcset={img.srcSet.attribute} sizes={featureSizes} src={img.src} alt="" />)}
  </template>
</BaseLayout>

<script>
  const preload = () => {
    const tpl = document.querySelector<HTMLTemplateElement>('[data-preload-features]');
    tpl?.content.querySelectorAll('img').forEach((src) => {
      const img = new Image();
      img.sizes = src.sizes;
      img.srcset = src.srcset;
      img.src = src.getAttribute('src') ?? '';
    });
  };
  const whenIdle = () =>
    'requestIdleCallback' in window ? requestIdleCallback(preload, { timeout: 3000 }) : setTimeout(preload, 1500);
  if (document.readyState === 'complete') whenIdle();
  else window.addEventListener('load', whenIdle, { once: true });
</script>

<style is:global>
  /*
    Smooth switching between service pages, using cross-document view transitions.
    Only the service pages opt in, so other navigations behave normally.
    Unsupported browsers (and reduced motion) just get a regular page load.
  */
  @media (prefers-reduced-motion: no-preference) {
    @view-transition {
      navigation: auto;
    }
  }

  /* Header stays put; the active pill and the page content get their own animations */
  .site-header {
    view-transition-name: site-header;
  }

  .tab__bar {
    view-transition-name: tab-bar;
  }

  .split {
    view-transition-name: service-body;
  }

  ::view-transition-group(root) {
    animation-duration: 0.35s;
  }

  /*
    The teal bar slides one column across. Every column is the same width, so the bar never
    changes shape: only transform animates, on the compositor. (Pinning the group size stops
    the default width/height tween, which runs on the main thread.)
  */
  ::view-transition-group(tab-bar) {
    animation-duration: 0.45s;
    animation-timing-function: var(--ease-out);
    width: 0 !important;
    height: 0 !important;
  }

  ::view-transition-old(tab-bar),
  ::view-transition-new(tab-bar) {
    inline-size: auto;
    block-size: auto;
    animation: none;
  }

  ::view-transition-old(tab-bar) {
    display: none;
  }

  /* Content slides in the direction of travel (types set by the pagereveal script) */
  ::view-transition-group(service-body) {
    animation-duration: 0.45s;
    animation-timing-function: var(--ease-out);
    /* Same compositor-only treatment as the pill: the copy differs in height between pages */
    width: 0 !important;
    height: 0 !important;
  }

  ::view-transition-old(service-body),
  ::view-transition-new(service-body) {
    inline-size: auto;
    block-size: auto;
  }

  html:active-view-transition-type(forward) {
    &::view-transition-old(service-body) {
      animation: svc-out-left 0.3s ease both;
    }
    &::view-transition-new(service-body) {
      animation: svc-in-right 0.5s var(--ease-out) 0.05s both;
    }
  }

  html:active-view-transition-type(backward) {
    &::view-transition-old(service-body) {
      animation: svc-out-right 0.3s ease both;
    }
    &::view-transition-new(service-body) {
      animation: svc-in-left 0.5s var(--ease-out) 0.05s both;
    }
  }

  @keyframes svc-out-left {
    to {
      opacity: 0;
      transform: translateX(-48px);
    }
  }

  @keyframes svc-in-right {
    from {
      opacity: 0;
      transform: translateX(48px);
    }
  }

  @keyframes svc-out-right {
    to {
      opacity: 0;
      transform: translateX(48px);
    }
  }

  @keyframes svc-in-left {
    from {
      opacity: 0;
      transform: translateX(-48px);
    }
  }
</style>

<style>
  .service {
    padding: clamp(8px, 1.5vw, 20px) var(--page-pad) 0;
  }

  .tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(12px, 2.5vw, 32px);
    margin-bottom: clamp(32px, 5vw, 56px);
    border-bottom: 1px solid var(--line);
  }

  .tab {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 100%;
    padding: 4px 0 18px;
    color: var(--color-muted);
    transition: color var(--dur-base);
  }

  .tab:hover {
    color: var(--color-ink);
  }

  .tab[aria-current='page'] {
    color: var(--color-ink);
  }

  .tab__num {
    font-size: 13px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.04em;
    color: var(--color-teal);
  }

  .tab__label {
    font-size: clamp(15px, 1.4vw, 19px);
    font-weight: var(--weight-medium);
    line-height: 1.25;
  }

  .tab__label--short {
    display: none;
  }

  /* Sits on the row's bottom rule */
  .tab__bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--color-teal);
    border-radius: 2px;
  }

  @media (max-width: 599px) {
    .tab__label--full {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .tab__label--short {
      display: block;
    }
  }

  .split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  h1 {
    font-size: clamp(44px, 6.5vw, 96px);
    line-height: 0.95;
    letter-spacing: var(--tracking-display);
  }

  .sub {
    font-size: clamp(20px, 1.8vw, 26px);
    font-weight: var(--weight-medium);
    color: var(--color-teal);
    line-height: 1.3;
  }

  .para {
    font-size: 18px;
    line-height: 1.65;
    color: var(--color-ink-soft);
  }

  .btn--ink {
    align-self: flex-start;
    margin-top: 8px;
    background: var(--color-ink);
    color: var(--color-white);
  }

  .btn--ink:hover {
    background: var(--color-teal);
    color: var(--color-white);
  }

  .feature {
    border-radius: 32px;
    overflow: hidden;
    aspect-ratio: 1 / 1.05;
  }

  .feature img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  h2 {
    margin: clamp(64px, 8vw, 110px) 0 28px;
    font-size: clamp(30px, 3.5vw, 48px);
    letter-spacing: var(--tracking-heading);
  }

  /* ---- Small-screen overrides: kept last so they always beat the base rules above ---- */

  /*
    Phones and tablets: one column, with the photo straight after the title and subheading
    instead of after all the copy, and cropped landscape so it doesn't fill the whole screen.
  */
  @media (max-width: 899px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    .copy {
      display: contents;
    }

    .copy h1 {
      order: 1;
    }

    .sub {
      order: 2;
    }

    .feature {
      order: 3;
      aspect-ratio: 4 / 3;
      margin-block: 4px 8px;
    }

    .para {
      order: 4;
    }

    .btn--ink {
      order: 5;
    }
  }
</style>
