---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/Gallery.astro';
import { services, serviceHref, galleryFor, routes, type Service } from '../../data/site';

export const getStaticPaths = (() =>
  services.map((service) => ({ params: { slug: service.slug }, props: { service } }))) satisfies GetStaticPaths;

interface Props {
  service: Service;
}

const { service } = Astro.props;
const gallery = galleryFor(service.slug);
const serviceOrder = services.map((s) => s.slug);
---

<BaseLayout title={service.title} description={service.body[0]}>
  <!--
    Tags the cross-document view transition as "forward" or "backward" so the content slides
    the right way. Inline and in <head> so it runs before the first paint, when pagereveal fires.
  -->
  <script slot="head" is:inline define:vars={{ serviceOrder }}>
    window.addEventListener('pagereveal', (e) => {
      const from = window.navigation?.activation?.from?.url;
      const to = window.navigation?.activation?.entry?.url;
      if (!e.viewTransition || !from || !to) return;
      const index = (url) => serviceOrder.findIndex((slug) => new URL(url).pathname.includes(`/services/${slug}/`));
      const a = index(from);
      const b = index(to);
      if (a < 0 || b < 0 || a === b) return;
      e.viewTransition.types.add(b > a ? 'forward' : 'backward');
    });
  </script>

  <section class="service">
    <div class="container">
      <nav aria-label="Services">
        <ul role="list" class="tabs">
          {
            services.map((s) => (
              <li>
                <a
                  class="tab"
                  href={serviceHref(s.slug)}
                  aria-current={s.slug === service.slug ? 'page' : undefined}
                >
                  {s.cardTitle}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="split">
        <div class="copy">
          <h1>{service.title}</h1>
          <p class="sub">{service.subtitle}</p>
          {service.body.map((para) => <p class="para">{para}</p>)}
          <a class="btn btn--ink" href={routes.contact}>Get in touch</a>
        </div>
        <div class="feature">
          <Image
            src={service.image}
            alt={service.imageAlt}
            widths={[480, 720, 960, 1280]}
            sizes="(min-width: 900px) 50vw, 100vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>

      <h2>Gallery</h2>
      <Gallery images={gallery} label={service.title} />
    </div>
  </section>
</BaseLayout>

<style is:global>
  /*
    Smooth switching between service pages, using cross-document view transitions.
    Only the service pages opt in, so other navigations behave normally.
    Unsupported browsers (and reduced motion) just get a regular page load.
  */
  @media (prefers-reduced-motion: no-preference) {
    @view-transition {
      navigation: auto;
    }
  }

  /* Header stays put; the active pill and the page content get their own animations */
  .site-header {
    view-transition-name: site-header;
  }

  .tab[aria-current='page'] {
    view-transition-name: active-tab;
  }

  .split {
    view-transition-name: service-body;
  }

  ::view-transition-group(root) {
    animation-duration: 0.35s;
  }

  /*
    The pill glides to the new tab while its old shape crossfades into the new one.
    Only transform and opacity animate, so it runs on the compositor and stays smooth
    while the new page is still loading. (The default group animation also tweens
    width and height, which runs on the main thread and stutters.)
  */
  ::view-transition-group(active-tab) {
    animation-duration: 0.4s;
    animation-timing-function: var(--ease-out);
    width: 0 !important;
    height: 0 !important;
  }

  /* Both snapshots keep their natural size, anchored to the moving top-left corner */
  ::view-transition-old(active-tab),
  ::view-transition-new(active-tab) {
    inline-size: auto;
    block-size: auto;
  }

  ::view-transition-old(active-tab) {
    animation-duration: 0.25s;
  }

  ::view-transition-new(active-tab) {
    animation-duration: 0.4s;
  }

  /* Content slides in the direction of travel (types set by the pagereveal script) */
  ::view-transition-group(service-body) {
    animation-duration: 0.45s;
    animation-timing-function: var(--ease-out);
    /* Same compositor-only treatment as the pill: the copy differs in height between pages */
    width: 0 !important;
    height: 0 !important;
  }

  ::view-transition-old(service-body),
  ::view-transition-new(service-body) {
    inline-size: auto;
    block-size: auto;
  }

  html:active-view-transition-type(forward) {
    &::view-transition-old(service-body) {
      animation: svc-out-left 0.3s ease both;
    }
    &::view-transition-new(service-body) {
      animation: svc-in-right 0.5s var(--ease-out) 0.05s both;
    }
  }

  html:active-view-transition-type(backward) {
    &::view-transition-old(service-body) {
      animation: svc-out-right 0.3s ease both;
    }
    &::view-transition-new(service-body) {
      animation: svc-in-left 0.5s var(--ease-out) 0.05s both;
    }
  }

  @keyframes svc-out-left {
    to {
      opacity: 0;
      transform: translateX(-48px);
    }
  }

  @keyframes svc-in-right {
    from {
      opacity: 0;
      transform: translateX(48px);
    }
  }

  @keyframes svc-out-right {
    to {
      opacity: 0;
      transform: translateX(48px);
    }
  }

  @keyframes svc-in-left {
    from {
      opacity: 0;
      transform: translateX(-48px);
    }
  }
</style>

<style>
  .service {
    padding: clamp(32px, 6vw, 80px) var(--page-pad) 0;
  }

  .tabs {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  .tab {
    display: block;
    padding: 10px 18px;
    border-radius: var(--radius-pill);
    font-size: 15px;
    font-weight: var(--weight-semibold);
    color: var(--color-ink);
    border: 1px solid var(--line-strong);
    transition:
      background-color var(--dur-base),
      border-color var(--dur-base),
      color var(--dur-base);
  }

  .tab:hover {
    color: var(--color-ink);
    border-color: var(--color-ink);
  }

  .tab[aria-current='page'] {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-white);
  }

  .split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  h1 {
    font-size: clamp(44px, 6.5vw, 96px);
    line-height: 0.95;
    letter-spacing: var(--tracking-display);
  }

  .sub {
    font-size: clamp(20px, 1.8vw, 26px);
    font-weight: var(--weight-medium);
    color: var(--color-teal);
    line-height: 1.3;
  }

  .para {
    font-size: 18px;
    line-height: 1.65;
    color: var(--color-ink-soft);
  }

  .btn--ink {
    align-self: flex-start;
    margin-top: 8px;
    background: var(--color-ink);
    color: var(--color-white);
  }

  .btn--ink:hover {
    background: var(--color-teal);
    color: var(--color-white);
  }

  .feature {
    border-radius: 32px;
    overflow: hidden;
    aspect-ratio: 1 / 1.05;
  }

  .feature img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  h2 {
    margin: clamp(64px, 8vw, 110px) 0 28px;
    font-size: clamp(30px, 3.5vw, 48px);
    letter-spacing: var(--tracking-heading);
  }
</style>
